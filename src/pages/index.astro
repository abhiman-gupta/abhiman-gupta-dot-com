---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import headshot from "../assets/images/headshot.jpg";

// Structured data so search engines know this page is about a person (schema.org Person). Facts only, no marketing copy.
const site = Astro.site!.href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abhiman Gupta",
  url: site,
  image: new URL("/og.jpg", site).href,
  jobTitle: "PhD student, Optical Sciences",
  affiliation: { "@type": "CollegeOrUniversity", name: "University of Arizona", url: "https://www.arizona.edu/" },
  sameAs: [
    "https://www.instagram.com/abhimangupta/",
    "https://www.linkedin.com/in/abhimangupta27/",
    "https://x.com/abhiman_gupta",
  ],
};
---
<Base
  title="Abhiman Gupta"
  description="Abhiman Gupta: third-year PhD student working on polarization ray tracing, computer rendering, and ophthalmology. Photographer."
  current="home"
  fullFooter
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  <section class="hero wrap" aria-label="Introduction">
    <div class="hero-text">
      <h1 class="hero-name"><em>Hi, I'm</em> Abhiman</h1>
      <p class="hero-lead">I'm a third-year PhD student working on the intersection of polarization ray tracing, computer rendering, and ophthalmology.</p>
      <p class="hero-lead">Outside of school, I’m interested in human health (particularly nutrition and resilience), lifestyle design, and financial markets.</p>
      <p class="hero-lead">I’ve also been taking photographs for over a decade, check them out on <a href="https://www.instagram.com/abhimangupta/" target="_blank" rel="noopener noreferrer">Instagram</a> or <a href="/photography/">here</a>.</p>
    </div>
    <figure class="hero-photo">
      <Image src={headshot} alt="Portrait of Abhiman Gupta" widths={[480, 720, 1080]} sizes="(max-width: 860px) 90vw, 40vw" loading="eager" />
    </figure>
  </section>
</Base>
