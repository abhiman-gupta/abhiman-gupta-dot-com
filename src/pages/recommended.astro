---
/**
 * Recommended: numbered one-line lists. Edit src/data/recommended.json to add things.
 * Each item: { "title", "by"?, "url"?, "note"? }. Sections show in the order they're listed in that file.
 */
import Base from "../layouts/Base.astro";
import data from "../data/recommended.json";

type Item = { title: string; by?: string; url?: string; note?: string };
type Section = { title: string; items: Item[] };
const sections = (data.sections as Section[]).map((s, i) => ({ ...s, id: `list-${i + 1}` }));
const isExternal = (url: string) => /^https?:\/\//.test(url);
---
<Base title="Recommended · Abhiman Gupta" description="Favorite X posts, articles, and Shark Tank pitches, picked by Abhiman Gupta." current="recommended">
  <header class="page-head wrap">
    <h1 class="page-title">Recommend<em>ed</em></h1>
  </header>

  <div class="lists wrap">
    {sections.map((s) => (
      <section class="list" aria-labelledby={s.id}>
        <h2 class="list-title label" id={s.id}>{s.title}</h2>
        {s.items.length > 0 ? (
          <ol>
            {s.items.map((it, i) => {
              const text = (
                <>
                  <span class="title">{it.title}</span>
                  {it.by && <>{" "}<span class="by">·&nbsp;{it.by}</span></>}
                </>
              );
              return (
                <li class="item">
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <span class="text">
                    {it.url ? (
                      <a href={it.url} {...(isExternal(it.url) ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{text}</a>
                    ) : (
                      text
                    )}
                    {it.note && <span class="note">{it.note}</span>}
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="empty-list">Coming soon</p>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  /* Numbered lists: numbers hang in a narrow gutter; section labels line up with the titles, not the numbers. */
  .lists { --gutter-num: 2.6rem; display: grid; gap: clamp(44px, 6vw, 80px); padding-bottom: clamp(70px, 10vw, 140px); }
  .list { max-width: 860px; }
  .list-title { margin: 0 0 14px; padding-left: var(--gutter-num); }
  .list ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { display: grid; grid-template-columns: var(--gutter-num) minmax(0, 1fr); align-items: baseline; }
  .num { font: 400 0.95rem/1 var(--display); color: var(--muted); font-variant-numeric: tabular-nums; }
  .title { font: 400 clamp(1.1rem, 1.6vw, 1.35rem)/1.35 var(--display); letter-spacing: var(--d-track-sm); }
  .by { color: var(--muted); font-size: 0.95rem; }
  .note { display: block; margin-top: 4px; color: var(--muted); font-size: 0.95rem; line-height: 1.5; }
  .text a .title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.22em; text-decoration-color: var(--line); transition: text-decoration-color 0.2s; }
  .text a:hover .title, .text a:focus-visible .title { text-decoration-color: var(--ink); }
  .empty-list { margin: 0; padding-left: var(--gutter-num); color: var(--muted); }
</style>
