---
/**
 * EXPERIMENT (not linked from the nav): the photography index as developed film dropped on the floor.
 * One strip of film per location in photography/locations/, lying at its own angle and overlapping the others.
 * Strips can be pushed around; picking one up straightens and enlarges it so its frames can be wound through,
 * and a frame opens in the same full-screen viewer the globe page uses.
 * Layout comes from :nth-child rules, not inline styles, because the Content-Security-Policy forbids those.
 */
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getLocations, placeLine } from "../../lib/photos";

/** A strip is never shorter than this many frames; the rest of a short roll is left unexposed. */
const MIN_FRAMES = 6;

const locations = await Promise.all(
  getLocations().map(async (l) => ({
    ...l,
    line: placeLine(l),
    blanks: Math.max(1, MIN_FRAMES - l.photos.length),
    frames: await Promise.all(
      l.photos.map(async (p) => {
        const img = await getImage({ src: p.image, widths: [400, 800], format: "webp", quality: 80 });
        const full = await getImage({ src: p.image, widths: [1000, 1600, 2400], format: "webp", quality: 85 });
        return { src: img.src, srcset: img.srcSet.attribute, w: p.image.width, h: p.image.height, full: full.src, fullSrcset: full.srcSet.attribute };
      })
    ),
  }))
);
/** The list at the foot of the page is always A to Z, whatever order the strips are dropped in. */
const byName = [...locations].sort((a, b) => a.name.localeCompare(b.name, "en", { sensitivity: "base" }));
---
<Base title="Photography · Abhiman Gupta" description="Photography by Abhiman Gupta, by place." current="photography">
  <section class="spill">
    <h1 class="sr-only">Photography</h1>

    <div class="floor" id="floor">
      {locations.map((l) => (
        <article class="roll" data-key={l.slug}>
          {/* Two layers that move as one. The film is see-through and darkens what lies under it; the photos sit in a
              second layer on top that is ordinary and opaque. The top layer repeats the row so everything lines up. */}
          <div class="strip base" aria-hidden="true">
            <div class="film">
              <div class="frames">
                <div class="leader"><span class="lname">{l.name}</span></div>
                {l.frames.map((t) => (
                  <div class="frame"><img src={t.src} srcset={t.srcset} width={t.w} height={t.h} sizes="200px" alt="" draggable="false" /></div>
                ))}
                {Array.from({ length: l.blanks }, () => <div class="frame blank" />)}
                <div class="leader"><span class="lname">{l.name}</span></div>
              </div>
            </div>
          </div>
          <div class="strip top">
            <div class="film">
              <div class="frames">
                <div class="leader" aria-hidden="true"><span class="lname">{l.name}</span></div>
                {l.frames.map((t, i) => (
                  <a href={t.full} class="frame shot" data-full={t.full} data-full-srcset={t.fullSrcset} data-i={i} tabindex="-1">
                    <img src={t.src} srcset={t.srcset} width={t.w} height={t.h} sizes="200px" alt={`${l.name}, photo ${i + 1}`} draggable="false" />
                  </a>
                ))}
                {Array.from({ length: l.blanks }, () => <div class="frame blank" aria-hidden="true" />)}
                <div class="leader" aria-hidden="true"><span class="lname">{l.name}</span></div>
              </div>
            </div>
            <button class="pick" aria-label={`${l.name}${l.line ? `, ${l.line}` : ""}. Pick up this roll`}></button>
          </div>
        </article>
      ))}

      <div class="held-head wrap" id="heldHead" hidden>
        <div>
          <h2 class="sr-only" id="heldName" tabindex="-1"></h2>
        </div>
        <button class="close label" id="heldClose">Put back ✕</button>
      </div>
      <div class="tip" id="tip" hidden></div>
    </div>
    <p class="label hint" id="hint" data-floor="Drag to move and click to expand" data-held="Drag to wind and click to expand">Drag to move and click to expand</p>
  </section>

  <section class="places wrap" aria-label="Places">
    <ul class="place-list">
      {byName.map((l) => (
        <li>
          <button class="place-btn" data-key={l.slug}>
            <span class="pname">{l.name}</span>
            {l.line && <span class="label">{l.line}</span>}
          </button>
        </li>
      ))}
    </ul>
  </section>

  <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <div class="viewer-bar">
      <p class="viewer-title"><span id="viewerPlace"></span> <span class="viewer-count" id="viewerCount"></span></p>
      <button class="viewer-close" id="viewerClose" aria-label="Close photo">Close ✕</button>
    </div>
    <div class="viewer-stage" id="viewerStage">
      <img id="viewerImg" alt="" sizes="100vw" draggable="false" />
    </div>
    <button class="viewer-nav prev" id="viewerPrev" aria-label="Previous photo">←</button>
    <button class="viewer-nav next" id="viewerNext" aria-label="Next photo">→</button>
  </div>
</Base>

<script>
  const el = (id: string) => document.getElementById(id)!;
  const floor = el("floor");
  const tip = el("tip");
  const hint = el("hint");
  const heldHead = el("heldHead");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

  /** node: the roll, which carries its position and state. box: its film layer, used for measuring. dx/dy: offset in px from where the stylesheet puts the strip. rot: its angle in degrees. vx/vy/vr: speed per ms while it slides. */
  type Roll = { node: HTMLElement; box: HTMLElement; pick: HTMLButtonElement; shots: HTMLAnchorElement[]; name: string; dx: number; dy: number; rot: number; vx: number; vy: number; vr: number };
  const rolls: Roll[] = [...floor.querySelectorAll<HTMLElement>(".roll")].map((node) => ({
    node,
    box: node.querySelector<HTMLElement>(".strip.base")!,
    pick: node.querySelector<HTMLButtonElement>(".pick")!,
    shots: [...node.querySelectorAll<HTMLAnchorElement>(".shot")],
    name: node.querySelector(".lname")?.textContent ?? "",
    dx: 0, dy: 0, rot: 0, vx: 0, vy: 0, vr: 0,
  }));
  const byKey = new Map(rolls.map((r) => [r.node.dataset.key!, r]));

  let held: Roll | null = null;
  let pan = 0;
  let panMax = 0;
  let scale = 1;
  let top = rolls.length;
  let topRoll: Roll | null = null;
  const raise = (r: Roll) => { if (r !== topRoll) { topRoll = r; r.node.style.setProperty("--z", String(++top)); } };
  const place = (r: Roll, x: number, y: number) => { r.node.style.setProperty("--dx", `${x}px`); r.node.style.setProperty("--dy", `${y}px`); };
  const turn = (r: Roll) => r.node.style.setProperty("--a", `${r.rot.toFixed(2)}deg`);
  /** Where the strip's middle is on the floor, in px. */
  const centre = (r: Roll) => ({ x: r.box.offsetLeft + r.dx, y: r.box.offsetTop + r.dy });
  /** Move a strip's middle to a point, kept on the floor so no roll can be lost off the edge. Returns false if it hit an edge. */
  function moveTo(r: Roll, x: number, y: number) {
    const cx = clamp(x, 0, floor.clientWidth), cy = clamp(y, 0, floor.clientHeight);
    r.dx = cx - r.box.offsetLeft; r.dy = cy - r.box.offsetTop;
    place(r, r.dx, r.dy);
    return cx === x && cy === y;
  }

  // ---------- A fresh spill on every visit ----------
  // Angles are dealt from evenly spaced slots so no two rolls land parallel; on tall screens they lean towards vertical.
  {
    const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
    const tall = floor.clientWidth < floor.clientHeight;
    const slots = rolls.map((_, i) => i).sort(() => Math.random() - 0.5);
    rolls.forEach((r, i) => {
      const wide = -65 + ((slots[i] + rand(0.15, 0.85)) * 130) / rolls.length;
      r.rot = tall ? Math.sign(wide || 1) * (90 - Math.abs(wide)) : wide;
      r.node.classList.add("loose");
      turn(r);
      r.node.style.setProperty("--spin", `${rand(8, 18) * (Math.random() < 0.5 ? -1 : 1)}deg`);
      moveTo(r, floor.clientWidth * rand(0.27, 0.73), floor.clientHeight * rand(0.3, 0.7));
    });
    requestAnimationFrame(() => requestAnimationFrame(() => rolls.forEach((r) => r.node.classList.remove("loose"))));
  }

  // ---------- Pick up / put back ----------
  /** Size the held strip to about three quarters of the floor's height and work out how far it can be wound either way. */
  function fit(r: Roll, keepPan = false) {
    // On narrow screens the width decides, so the name on the leader fits across the screen.
    const want = Math.min(floor.clientHeight * 0.72, 570, floor.clientWidth * 0.6);
    scale = want / r.box.offsetHeight;
    const width = r.box.offsetWidth * scale;
    panMax = Math.max(0, (width - floor.clientWidth) / 2 + 24);
    // Every roll opens at its left end, on the name; the frames are wound in from the right.
    if (!keepPan) pan = panMax;
    pan = clamp(pan, -panMax, panMax);
    r.node.style.setProperty("--s", String(scale));
    place(r, pan, 0);
  }
  function hold(r: Roll) {
    if (held === r) return;
    if (held) drop(false);
    held = r;
    rest(r);
    raise(r);
    floor.classList.add("holding");
    r.node.classList.add("held");
    fit(r);
    for (const a of r.shots) { a.tabIndex = 0; a.querySelector("img")!.sizes = "(max-width: 700px) 90vw, 900px"; }
    r.pick.tabIndex = -1;
    el("heldName").textContent = r.name;
    heldHead.hidden = false;
    hint.textContent = hint.dataset.held ?? "";
    tip.hidden = true;
    el("heldName").focus({ preventScroll: true });
  }
  function drop(refocus = true) {
    const r = held;
    if (!r) return;
    held = null;
    floor.classList.remove("holding");
    r.node.classList.remove("held");
    r.node.style.removeProperty("--s");
    place(r, r.dx, r.dy);
    for (const a of r.shots) a.tabIndex = -1;
    r.pick.tabIndex = 0;
    heldHead.hidden = true;
    hint.textContent = hint.dataset.floor ?? "";
    if (refocus) r.pick.focus({ preventScroll: true });
  }
  new ResizeObserver(() => { if (held) fit(held, true); }).observe(floor);

  // ---------- Push around on the floor, wind while held ----------
  // A roll on the floor is held by the point you grabbed, so pushing it off-centre swings it round as well as moving it.
  // gx/gy is that point measured along and across the strip; t is when the pointer last moved.
  let drag: { r: Roll; x: number; y: number; moved: number; gx: number; gy: number; t: number } | null = null;
  let dragged = false;
  const RAD = Math.PI / 180;
  const SLIDE_MS = 170; // how long a released roll takes to lose most of its speed
  const sliding = new Set<Roll>();
  let slideT = 0;
  function slide(now: number) {
    const dt = Math.min(40, now - slideT);
    slideT = now;
    const keep = Math.exp(-dt / SLIDE_MS);
    for (const r of sliding) {
      const c = centre(r);
      if (!moveTo(r, c.x + r.vx * dt, c.y + r.vy * dt)) { r.vx = 0; r.vy = 0; }
      r.rot += r.vr * dt;
      turn(r);
      r.vx *= keep; r.vy *= keep; r.vr *= keep;
      if (Math.hypot(r.vx, r.vy) < 0.02 && Math.abs(r.vr) < 0.004) rest(r);
    }
    if (sliding.size) requestAnimationFrame(slide);
  }
  function rest(r: Roll) {
    r.vx = r.vy = r.vr = 0;
    if (sliding.delete(r)) r.node.classList.remove("loose");
  }
  for (const r of rolls) {
    r.node.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || (held && held !== r)) return;
      rest(r);
      const box = floor.getBoundingClientRect(), c = centre(r);
      const ox = e.clientX - box.left - c.x, oy = e.clientY - box.top - c.y;
      const cos = Math.cos(r.rot * RAD), sin = Math.sin(r.rot * RAD);
      drag = { r, x: e.clientX, y: e.clientY, moved: 0, gx: ox * cos + oy * sin, gy: -ox * sin + oy * cos, t: performance.now() };
      dragged = false;
      if (!held) raise(r);
    });
    r.pick.addEventListener("click", () => { if (!dragged) hold(r); });
    for (const a of r.shots) {
      a.addEventListener("click", (e) => { e.preventDefault(); if (!dragged && held === r) openViewer(r, a); });
      a.addEventListener("focus", () => {
        if (held !== r) return;
        pan = clamp((r.box.offsetWidth / 2 - (a.offsetLeft + a.offsetWidth / 2)) * scale, -panMax, panMax);
        place(r, pan, 0);
      });
    }
  }
  // Pointing brings a roll to the top of the pile before any click. A photo under the pointer wins, even when another
  // roll's film is lying over it: people aim at pictures, not at film edges. With no photo there, it is whichever roll
  // is already uppermost at that spot; with two photos there, the upper one.
  const byNode = new Map(rolls.map((r) => [r.node, r]));
  floor.addEventListener("pointermove", (e) => {
    if (held || drag || e.pointerType !== "mouse") return;
    const under = document.elementsFromPoint(e.clientX, e.clientY);
    const hit = under.find((n) => n.closest(".shot")) ?? under.find((n) => n.closest(".roll"));
    const r = hit ? byNode.get(hit.closest<HTMLElement>(".roll")!) : undefined;
    if (!r) { tip.hidden = true; return; }
    raise(r);
    tip.textContent = r.name;
    const box = floor.getBoundingClientRect();
    tip.style.transform = `translate(${e.clientX - box.left + 14}px, ${e.clientY - box.top + 14}px)`;
    tip.hidden = false;
  });
  floor.addEventListener("pointerleave", () => { tip.hidden = true; });
  window.addEventListener("pointermove", (e) => {
    if (!drag) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    drag.x = e.clientX; drag.y = e.clientY;
    drag.moved += Math.abs(dx) + Math.abs(dy);
    if (drag.moved < 5) return;
    const r = drag.r;
    r.node.classList.add("dragging");
    tip.hidden = true;
    if (held === r) { pan = clamp(pan + dx, -panMax, panMax); place(r, pan, 0); return; }
    // The grabbed point stays under the pointer. Sideways movement there turns the strip, less so the nearer the
    // grab is to the middle (the added term is the strip's reluctance to spin).
    const now = performance.now(), dt = Math.max(1, now - drag.t);
    drag.t = now;
    const before = centre(r);
    let cos = Math.cos(r.rot * RAD), sin = Math.sin(r.rot * RAD);
    const ax = drag.gx * cos - drag.gy * sin, ay = drag.gx * sin + drag.gy * cos;
    const dRot = (ax * dy - ay * dx) / (ax * ax + ay * ay + (r.box.offsetWidth * 0.3) ** 2) / RAD;
    r.rot += dRot;
    turn(r);
    cos = Math.cos(r.rot * RAD); sin = Math.sin(r.rot * RAD);
    const box = floor.getBoundingClientRect();
    moveTo(r, e.clientX - box.left - (drag.gx * cos - drag.gy * sin), e.clientY - box.top - (drag.gx * sin + drag.gy * cos));
    const after = centre(r);
    // Running average of speed, so the throw follows the last stretch of the push and not one jittery sample.
    r.vx += ((after.x - before.x) / dt - r.vx) * 0.4;
    r.vy += ((after.y - before.y) / dt - r.vy) * 0.4;
    r.vr += (dRot / dt - r.vr) * 0.4;
  });
  const endDrag = () => {
    if (!drag) return;
    dragged = drag.moved >= 5;
    const r = drag.r, still = performance.now() - drag.t > 80;
    r.node.classList.remove("dragging");
    drag = null;
    // Let go while moving and the roll slides on and settles; let go after a pause and it stays put.
    if (held === r || !dragged || still || reduced) { r.vx = r.vy = r.vr = 0; return; }
    r.node.classList.add("loose");
    sliding.add(r);
    if (sliding.size === 1) { slideT = performance.now(); requestAnimationFrame(slide); }
  };
  window.addEventListener("pointerup", endDrag);
  window.addEventListener("pointercancel", endDrag);

  floor.addEventListener("wheel", (e) => {
    if (!held || panMax === 0) return;
    e.preventDefault();
    pan = clamp(pan - (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY), -panMax, panMax);
    held.node.classList.add("dragging");
    place(held, pan, 0);
    held.node.classList.remove("dragging");
  }, { passive: false });

  // A click on the bare floor puts the roll back.
  floor.addEventListener("click", (e) => {
    if (held && !dragged && !(e.target as HTMLElement).closest(".roll, .held-head")) drop();
  });
  el("heldClose").addEventListener("click", () => drop());
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && held && viewer.hidden) drop(); });
  document.querySelectorAll<HTMLButtonElement>(".place-btn").forEach((b) => b.addEventListener("click", () => {
    const r = byKey.get(b.dataset.key!);
    if (!r) return;
    window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    hold(r);
  }));

  // ---------- Photo viewer (same behaviour as the globe page) ----------
  const viewer = el("viewer");
  const viewerImg = el("viewerImg") as HTMLImageElement;
  let shots: HTMLAnchorElement[] = [];
  let shot = 0;
  let opener: HTMLElement | null = null;
  function showShot(i: number) {
    shot = (i + shots.length) % shots.length;
    const a = shots[shot];
    viewerImg.classList.add("swap");
    viewerImg.srcset = a.dataset.fullSrcset ?? "";
    viewerImg.src = a.dataset.full ?? a.href;
    viewerImg.alt = a.querySelector("img")!.alt;
    const many = shots.length > 1;
    el("viewerCount").textContent = many ? `${shot + 1} / ${shots.length}` : "";
    el("viewerPrev").hidden = !many;
    el("viewerNext").hidden = !many;
  }
  viewerImg.addEventListener("load", () => viewerImg.classList.remove("swap"));
  function openViewer(r: Roll, a: HTMLAnchorElement) {
    shots = r.shots;
    el("viewerPlace").textContent = r.name;
    opener = a;
    viewer.hidden = false;
    document.documentElement.classList.add("viewer-open");
    showShot(Number(a.dataset.i));
    el("viewerClose").focus();
  }
  function closeViewer() {
    viewer.hidden = true;
    document.documentElement.classList.remove("viewer-open");
    viewerImg.removeAttribute("src");
    viewerImg.removeAttribute("srcset");
    opener?.focus({ preventScroll: true });
  }
  el("viewerClose").addEventListener("click", closeViewer);
  el("viewerPrev").addEventListener("click", () => showShot(shot - 1));
  el("viewerNext").addEventListener("click", () => showShot(shot + 1));
  document.addEventListener("keydown", (e) => {
    if (viewer.hidden) return;
    if (e.key === "Escape") closeViewer();
    else if (e.key === "ArrowRight" && shots.length > 1) showShot(shot + 1);
    else if (e.key === "ArrowLeft" && shots.length > 1) showShot(shot - 1);
    else return;
    e.preventDefault();
  });
  let swipe: { x: number; y: number } | null = null;
  const vStage = el("viewerStage");
  vStage.addEventListener("pointerdown", (e) => { swipe = { x: e.clientX, y: e.clientY }; });
  vStage.addEventListener("pointerup", (e) => {
    if (!swipe) return;
    const dx = e.clientX - swipe.x, dy = e.clientY - swipe.y;
    swipe = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) && shots.length > 1) showShot(shot + (dx < 0 ? 1 : -1));
    else if (Math.abs(dx) < 6 && Math.abs(dy) < 6 && e.target === vStage) closeViewer();
  });
</script>

<style>
  /* The floor is the whole first screen and runs up underneath the site header; it stops short of the list and footer. */
  .spill { --headerH: 68px; position: relative; display: flex; flex-direction: column; height: 100svh; min-height: 560px; margin-top: calc(-1 * var(--headerH)); }
  /* Text that sits over the floor is plain dark ink with no background: it reads on the paper and on the mid-grey film.
     (Inverting it against what's underneath was tried and fails on mid grey, where the inverse is the same grey.) */
  .hint { position: absolute; z-index: 2; inset: auto 0 clamp(14px, 2vw, 24px); text-align: center; pointer-events: none; color: color-mix(in srgb, var(--ink) 78%, transparent); }
  :global(.site-header) { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; pointer-events: none; }
  :global(.site-header a), :global(.site-header button) { pointer-events: auto; }
  :global(.site-header .nav a) { color: color-mix(in srgb, var(--ink) 62%, transparent); }
  :global(.site-header .nav a:hover), :global(.site-header .nav a[aria-current="page"]) { color: var(--ink); }

  /* isolation keeps the strips' stacking and blending inside the floor, so a raised strip never climbs over the header. */
  .floor { position: relative; z-index: 0; isolation: isolate; flex: 1; min-height: 0; overflow: clip; background: var(--paper); --h: clamp(96px, 11.5vw, 184px); }

  /* ---------- One roll of film ----------
     A roll is two layers, .base (the film) and .top (its photos), given the same position, angle and size through
     the variables below so they move as one. The roll itself must not become a stacking context (no transform,
     opacity, filter or z-index on it), or the film could no longer blend with the rolls underneath.
     --h is the film's full height (the 35 mm), --band the perforated edge, --pitch the perforation spacing. */
  .roll { --x: 50%; --y: 50%; }
  .strip {
    --band: calc(var(--h) * 0.17); --pitch: calc(var(--h) * 0.136);
    --rot: var(--a, var(--r-wide, 0deg));
    position: absolute; left: var(--x); top: var(--y); z-index: var(--z, auto); height: var(--h);
    transform: translate(-50%, -50%) translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--rot)) scale(var(--s, 1));
    transition: transform 0.7s var(--ease), left 0.7s var(--ease), top 0.7s var(--ease), opacity 0.5s, filter 0.5s;
    animation: fall 0.9s var(--ease) var(--delay, 0s) both; cursor: grab; touch-action: pan-y;
    user-select: none; -webkit-user-select: none;
  }
  /* Film is a filter, not paint: it multiplies whatever lies under it, so a roll underneath (photos included) shows
     through the one on top and every extra layer makes the pile darker. Its own photos are in .top and stay solid. */
  .strip.base {
    mix-blend-mode: multiply;
    filter: drop-shadow(0 calc(var(--h) * 0.045) calc(var(--h) * 0.075) rgba(0, 0, 0, 0.25));
  }
  /* While a roll is being pushed, is sliding, or is being scattered, script places it every frame: no easing on top. */
  .roll.dragging .strip, .roll.loose .strip { transition: opacity 0.4s, filter 0.3s; }
  .roll.dragging .strip { cursor: grabbing; }
  @keyframes fall { from { opacity: 0; translate: 0 -9vh; scale: 1.16; rotate: var(--spin, 12deg); } }
  @media (hover: hover) {
    .floor:not(.holding) .roll:hover .strip { --s: 1.03; }
    .floor:not(.holding) .roll:hover .strip.base { filter: drop-shadow(0 calc(var(--h) * 0.09) calc(var(--h) * 0.14) rgba(0, 0, 0, 0.29)); }
  }

  /* Where each roll lands if the script that scatters them afresh on every visit hasn't run: angles repeat every 7
     rolls and positions every 5, so no two near neighbours match.
     --r-tall is the same angle measured from vertical, for screens taller than they are wide. */
  .roll:nth-child(7n + 1) { --r-wide: -21deg; --r-tall: -69deg; }
  .roll:nth-child(7n + 2) { --r-wide: 34deg; --r-tall: 56deg; }
  .roll:nth-child(7n + 3) { --r-wide: -52deg; --r-tall: -38deg; }
