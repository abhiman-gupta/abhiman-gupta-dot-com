  .lplace { display: none; margin-top: 0.9em; font: 600 calc(var(--h) * 0.026) / 1.2 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: #8f8d86; }
  .roll.held .leader, .roll.gathered .leader { width: auto; padding-inline: calc(var(--h) * 0.14); }
  .roll.held .lname, .roll.gathered .lname, .roll.held .lplace, .roll.gathered .lplace { display: block; }
  /* Gathered rolls are shown big, so their names are smaller than on a held roll, leaving room for the photos. */
