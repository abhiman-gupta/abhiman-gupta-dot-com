  .base .film::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(102deg, transparent 32%, rgba(255, 255, 255, 0.08) 46%, transparent 58%); }
  /* On the floor the film has a stretch of blank film at both ends, the same length (the tail matches the leader plus
     its margin). A held roll stops just after its last frame, the same gap from it as between frames. */
  .frames { display: flex; align-items: stretch; gap: calc(var(--h) * 0.04); height: 100%; padding: var(--band) calc(var(--h) * 0.57) var(--band) calc(var(--h) * 0.12); }
  .roll.held .frames { padding-right: calc(var(--h) * 0.04); }
