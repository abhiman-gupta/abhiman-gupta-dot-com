  .frame { flex: none; display: block; height: 100%; aspect-ratio: var(--r, 3 / 2); border-radius: calc(var(--h) * 0.012); overflow: hidden; }
  .frame img { display: block; width: 100%; height: 100%; max-width: none; object-fit: cover; background: #2a2927; }
  /* An unexposed frame is the densest part of slide film, so it is darker than the base around it. */
  .frame.blank { aspect-ratio: 3 / 2; background: rgba(0, 0, 0, 0.26); }
  /* Blank frames only pad out a short roll on the floor; a held roll is just its photos. */
