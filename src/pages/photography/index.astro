  .top .leader { visibility: hidden; }
  /* Its blank frames show only on the silver of a lifted roll. */
  .top .blank { opacity: var(--silver, 0); }
  /* The roll's name, written on the leader at both ends so one is in view however the strip lies. */
  /* The leader at the start of the film. On the floor it is blank (the name was a lot of text there, and real film has
