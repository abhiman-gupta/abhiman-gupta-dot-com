  .top .film::before { z-index: -1; background: linear-gradient(102deg, transparent 32%, rgba(255, 255, 255, 0.08) 46%, transparent 58%), rgb(135, 136, 138); }
  /* The real film's shadow goes when it is hidden, so the silver brings its own. */
