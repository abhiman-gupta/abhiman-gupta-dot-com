  if (!uSize) loadMap();

  let globeOpen = false;
  /** Where the globe faces each time it is opened: the middle of the United States (longitude, latitude). */
  const OPEN_AT: [number, number] = [-98, 38];
  let rot: [number, number] = homeMarker ? [-homeMarker.lon, -homeMarker.lat] : [100, -28];
  let zoom = 1, vel = 0, dirty = true, lastInteract = 0, dragging = false;
  let hovered: string | null = null;
  let fly: { from: [number, number, number]; to: [number, number, number]; t0: number; dur: number } | null = null;
  let smallPx = 100, bigPx = 600;

  /** The globe box is always laid out at its open size, centred; closed, a transform shrinks it and moves it onto the
      button in the lower right corner, so opening it is one move to the middle. */
  function layoutGlobe() {
    // Short screens (a phone on its side) give the open globe more of the height.
    const H = floor.clientHeight;
    bigPx = Math.max(smallPx, Math.min(floor.clientWidth - 32, H - 2 * (H < 520 ? 64 : 96), 820));
    globeBox.style.width = `${bigPx}px`;
    globeWrap.style.setProperty("--big", `${bigPx}px`);
    seatGlobe();
    // The arrows sit beside the globe when there is room for them, otherwise under it.
    globeWrap.classList.toggle("nudge-below", (floor.clientWidth - bigPx) / 2 < 210);
    sizeCanvas();
  }
  /** Where the small globe sits: on its button. The button is hidden while the globe is open and can't be measured
      then, so a resize with the globe open keeps the old seat and closeGlobe measures again. */
  function seatGlobe() {
    if (globeOpenBtn.offsetWidth) {
      smallPx = globeOpenBtn.offsetWidth;
      globeWrap.style.setProperty("--cx", `${globeOpenBtn.offsetLeft + smallPx / 2 - floor.clientWidth / 2}px`);
      globeWrap.style.setProperty("--cy", `${globeOpenBtn.offsetTop + smallPx / 2 - floor.clientHeight / 2}px`);
    }
    globeWrap.style.setProperty("--k", String(smallPx / bigPx));
  }
  /** Only an open globe is drawn at full resolution; the small one is a fraction of the pixels. */
  function sizeCanvas() {
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = Math.round((globeOpen ? bigPx : smallPx) * dpr);
    if (w > 0 && canvas.width !== w) { canvas.width = w; canvas.height = w; dirty = true; }
  }

  function render() {
    projection.rotate([rot[0], rot[1]]).scale(R * zoom);
    if (gl && glReady) {
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uSize, canvas.width, canvas.height);
      gl.uniform1f(uRadius, R * zoom);
      gl.uniform2f(uCenter, (-rot[0] * Math.PI) / 180, (-rot[1] * Math.PI) / 180);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    } else {
      el("fallbackSphere").setAttribute("d", path({ type: "Sphere" }) ?? "");
      el("fallbackLand").setAttribute("d", landShape ? path(landShape) ?? "" : "");
    }
    el("graticule").setAttribute("d", path(graticule) ?? "");
    el("borders").setAttribute("d", borders ? path(borders) ?? "" : "");
    el("stateBorders").setAttribute("d", stateBorders ? path(stateBorders) ?? "" : "");
    const center: [number, number] = [-rot[0], -rot[1]];
    for (const p of pins) {
      const xy = projection(p.at);
      p.visible = !!xy && geoDistance(p.at, center) < Math.PI / 2 - 0.03 && Math.hypot(xy[0] - VB / 2, xy[1] - VB / 2) < LENS - 4;
      p.g.classList.toggle("hidden", !p.visible);
      if (xy) { p.g.setAttribute("transform", `translate(${xy[0].toFixed(1)} ${xy[1].toFixed(1)})`); }
    }
    updateNudges();
    dirty = false;
  }

  // Arrows saying how many collections are round the back of the globe on each side; clicking one turns the globe to
  // the nearest of them. They stay up for as long as anything is out of view, so nobody misses that it turns.
  const nudges = {
    left: { btn: el("nudgeL") as HTMLButtonElement, key: "-", targets: [] as Spot[] },
    right: { btn: el("nudgeR") as HTMLButtonElement, key: "-", targets: [] as Spot[] },
  };
  function updateNudges() {
    const left: { m: Spot; d: number }[] = [], right: { m: Spot; d: number }[] = [];
    for (const p of pins) {
      if (p.visible) continue;
      const d = wrap180(p.m.lon + rot[0]); // + means east of the view centre, i.e. round to the right
      (d >= 0 ? right : left).push({ m: p.m, d: Math.abs(d) });
    }
    for (const [side, list] of [["left", left], ["right", right]] as const) {
      const n = nudges[side];
      n.targets = list.sort((a, b) => a.d - b.d).map((x) => x.m);
      const key = n.targets.map((m) => m.key).join(",");
      if (key === n.key) continue;
      n.key = key;
      const count = n.targets.reduce((sum, t) => sum + t.keys.length, 0), on = count > 0 && globeOpen;
      n.btn.classList.toggle("show", count > 0);
      n.btn.tabIndex = on ? 0 : -1;
      n.btn.setAttribute("aria-hidden", on ? "false" : "true");
      if (count) {
        n.btn.querySelector(".ntext")!.textContent = `${WORDS[count] ?? count} more ${count === 1 ? "collection" : "collections"}`;
        n.btn.setAttribute("aria-label", `Turn the globe ${side}: ${count} more ${count === 1 ? "collection" : "collections"} that way`);
      }
