</script>

<style>
  /* The floor is the whole first screen and runs up underneath the site header; it stops short of the footer. */
  .spill { --headerH: 68px; position: relative; display: flex; flex-direction: column; height: 100svh; min-height: 320px; margin-top: calc(-1 * var(--headerH)); }
  :global(.site-header) { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; pointer-events: none; }
  :global(.site-header a), :global(.site-header button) { pointer-events: auto; }
  /* The site-wide grain is a full-screen blended layer over everything, so it had to be re-blended whenever anything
     under it moved. This page has its own paper grain on the floor, so it goes without. */
  :global(.grain) { display: none; }
  :global(.site-header .nav a) { color: color-mix(in srgb, var(--ink) 62%, transparent); }
  :global(.site-header .nav a:hover), :global(.site-header .nav a[aria-current="page"]) { color: var(--ink); }

  /* isolation keeps the strips' stacking and blending inside the floor, so a raised strip never climbs over the header. */
  .floor { position: relative; z-index: 0; isolation: isolate; flex: 1; min-height: 0; overflow: clip; background: var(--paper); --h: clamp(115px, 13.8vw, 221px); }
  @media (max-width: 699px) { .floor { --h: 100px; } }
