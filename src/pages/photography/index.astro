---
/**
 * The photography index: developed film dropped on the floor.
 * One strip of film per location in photography/locations/, lying at its own angle and overlapping the others.
 * Strips can be pushed around; picking one up (a click, or by touch a tap to lift it and a second to open it)
 * straightens and enlarges it so its frames can be wound through,
 * and a frame opens in a full-screen viewer.
 * Only the featured rolls are on the floor ("featured": true in location.json), 6 at most (3 on phones); if none is
 * featured, a random few are. Every collection is on the globe, and the others' photos load only when needed.
 * A small globe sits in the lower right corner. Clicking it opens it up: a turning globe (WebGL, textured with Natural
 * Earth II, public/textures/earth.jpg) with a red marker on each place; clicking a marker puts the globe away and picks up
 * that place's roll straight away (or gathers them, where several were shot there). The globe hides while a roll is picked up.
 * A held roll counts its frames, winds with the arrow keys and offers the next roll at its end; the viewer runs on into
 * the next collection too.
 * Layout comes from :nth-child rules, not inline styles, because the Content-Security-Policy forbids those.
 */
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getLocations, placeLine } from "../../lib/photos";

/** On the floor a strip shows every photo in its collection and is never shorter than this many frames; the rest of a short roll is left unexposed. Picked up, it shows only its photos. */
const MIN_FRAMES = 4;

const locations = await Promise.all(
  getLocations().map(async (l) => ({
    ...l,
    line: placeLine(l),
    /** Where it was shot, as written under the name on a picked-up roll: city and state (or region), else the country. */
    // A region-only collection ({ country, region }) has the region as its place too, so it isn't repeated.
    where: [l.place, l.region && l.region !== l.place ? l.region : l.country !== l.place ? l.country : undefined].filter(Boolean).join(", "),
    blanks: Math.max(0, MIN_FRAMES - l.photos.length),
    frames: await Promise.all(
      l.photos.map(async (p) => {
        const img = await getImage({ src: p.image, widths: [400, 800, 1600], format: "webp", quality: 80 });
        const full = await getImage({ src: p.image, widths: [1000, 1600, 2400], format: "webp", quality: 85 });
        return { src: img.src, srcset: img.srcSet.attribute, w: p.image.width, h: p.image.height, full: full.src, fullSrcset: full.srcSet.attribute };
      })
    ),
  }))
);
/** The place the globe turns to first. */
const HOME = "tucson";
const markers = JSON.stringify(locations.map((l) => ({ key: l.slug, name: l.name, place: l.place, n: l.photos.length, lat: l.lat, lon: l.lon, z: l.exact ? 2.4 : 1.6 })));
---
<Base title="Photography · Abhiman Gupta" description="Photography by Abhiman Gupta, by place." current="photography">
  <section class="spill">
    <h1 class="sr-only">Photography</h1>

    <div class="floor" id="floor">
      {locations.map((l) => (
        <article class="roll" data-key={l.slug} data-featured={l.featured ? "" : undefined}>
          {/* Two layers that move as one. The film is see-through and darkens what lies under it; the photos sit in a
              second layer on top that is ordinary and opaque. The top layer repeats the row so everything lines up. */}
          <div class="strip base" aria-hidden="true">
            <div class="film">
              <div class="frames">
                <div class="leader"><span class="lname">{l.name}</span><span class="lplace">{l.where}</span></div>
                {l.frames.map((t) => (
                  <div class="frame" style={`--r: ${t.w} / ${t.h}`}><img data-src={t.src} data-srcset={t.srcset} width={t.w} height={t.h} sizes="200px" alt="" draggable="false" /></div>
                ))}
                {Array.from({ length: l.blanks }, () => <div class="frame blank" />)}
              </div>
            </div>
          </div>
          <div class="strip top">
            <div class="film">
              <div class="frames">
                <div class="leader" aria-hidden="true"><span class="lname">{l.name}</span><span class="lplace">{l.where}</span></div>
                {l.frames.map((t, i) => (
                  <a href={t.full} class="frame shot" style={`--r: ${t.w} / ${t.h}`} data-full={t.full} data-full-srcset={t.fullSrcset} data-i={i} tabindex="-1">
                    <img data-src={t.src} data-srcset={t.srcset} width={t.w} height={t.h} sizes="200px" alt={`${l.name}, photo ${i + 1}`} draggable="false" />
                  </a>
                ))}
                {Array.from({ length: l.blanks }, () => <div class="frame blank" aria-hidden="true" />)}
              </div>
            </div>
            <button class="pick" aria-label={`${l.name}${l.line ? `, ${l.line}` : ""}. Pick up this roll`}></button>
          </div>
        </article>
      ))}

      {/* Photos are given as data-src: a roll's pictures load only once it is on the floor. */}
      {/* The globe is drawn at its open size and shrunk with a transform, so opening it is one smooth scale. */}
      <div class="globe-wrap" id="globeWrap">
        <div class="globe-box" id="globeBox">
          <canvas id="earth" class="earth" aria-hidden="true"></canvas>
          <svg id="globe" class="globe" viewBox="0 0 800 800" role="img" aria-label="Globe. Drag to turn it; red markers show where the photographs were taken." data-markers={markers} data-home={HOME}>
            <defs>
              <clipPath id="lens"><circle cx="400" cy="400" r="361" /></clipPath>
            </defs>
            <g clip-path="url(#lens)">
              <path class="fallback-sphere" id="fallbackSphere" />
              <path class="fallback-land" id="fallbackLand" />
              <path class="graticule" id="graticule" />
              <path class="borders" id="borders" />
              <path class="state-borders" id="stateBorders" />
              <g id="pins"></g>
            </g>
          </svg>
        </div>
        <button class="nudge left" id="nudgeL" tabindex="-1" aria-hidden="true"><span class="arrow" aria-hidden="true">←</span><span class="ntext"></span></button>
        <button class="nudge right" id="nudgeR" tabindex="-1" aria-hidden="true"><span class="ntext"></span><span class="arrow" aria-hidden="true">→</span></button>
        <button class="globe-open" id="globeOpen" aria-label="Open the globe to see where each roll was shot"><span class="globe-cue label" aria-hidden="true">See more</span></button>
      </div>
      <div class="globe-zoom" id="globeZoom" hidden>
        <button id="zoomIn" aria-label="Zoom in">+</button>
        <button id="zoomOut" aria-label="Zoom out">−</button>
      </div>
      <div class="held-head wrap" id="globeHead" hidden>
        <button class="close label" id="globeClose">Close ✕</button>
      </div>

      <div class="held-head split wrap" id="gatherHead" hidden>
        <p class="label gather-title" id="gatherTitle"></p>
        <button class="more-rolls" id="gatherUp" hidden><span class="arrow" aria-hidden="true">↑</span><span class="mtext"></span></button>
        <button class="close label" id="gatherClose">Put back ✕</button>
      </div>
      <button class="more-rolls below" id="gatherDown" hidden><span class="mtext"></span><span class="arrow" aria-hidden="true">↓</span></button>

      <div class="held-head split wrap" id="heldHead" hidden>
        <div>
          <h2 class="sr-only" id="heldName" tabindex="-1"></h2>
          <p class="label held-count"><span class="held-title" id="heldTitle"></span><span id="heldCount" aria-live="polite"></span></p>
        </div>
        <div class="held-actions">
          <button class="next-roll" id="nextRoll" hidden><span id="nextName"></span><span class="arrow" aria-hidden="true">→</span></button>
          <button class="close label" id="heldClose">Put back ✕</button>
        </div>
      </div>
      <div class="tip" id="tip" hidden></div>
    </div>
  </section>


  <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <div class="viewer-bar">
      <p class="viewer-title"><span id="viewerPlace"></span> <span class="viewer-count" id="viewerCount"></span></p>
      <button class="viewer-close" id="viewerClose" aria-label="Close photo">Close ✕</button>
    </div>
    <div class="viewer-stage" id="viewerStage">
      <img id="viewerImg" alt="" sizes="100vw" draggable="false" />
    </div>
    <button class="viewer-nav prev" id="viewerPrev" aria-label="Previous photo">←</button>
    <button class="viewer-nav next" id="viewerNext" aria-label="Next photo">→</button>
  </div>
</Base>

<script>
  import { geoOrthographic, geoPath, geoGraticule10, geoDistance, type GeoPermissibleObjects } from "d3-geo";
  import type { Topology, GeometryCollection } from "topojson-specification";

  const el = (id: string) => document.getElementById(id)!;
  const floor = el("floor");
  // Safari can run this script before the stylesheet has arrived (Chrome waits for it). Everything below measures the
  // floor to lay the rolls out, and measured unstyled the floor is tens of thousands of px tall, which put every roll
  // far off screen for good: a floor with no film on it. So nothing starts until the floor has its styles.
  const styled = () => getComputedStyle(floor).position === "relative";
  if (!styled()) {
    await new Promise<void>((done) => {
      const t0 = performance.now();
      const check = () => { if (styled() || performance.now() - t0 > 15000) done(); else setTimeout(check, 30); };
      for (const link of document.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')) link.addEventListener("load", check, { once: true });
      check();
    });
  }
  const tip = el("tip");
  const heldHead = el("heldHead"), heldCount = el("heldCount");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));
  /** While a roll is held, rolls are gathered or the globe is open, the page goes back to the top and stays there: the
      page scrolls a little (down to the footer), and scrolled, the Put back row would slide up under the site header. */
  function settle() {
    const busy = !!(held || gathered || globeOpen);
    if (busy && window.scrollY > 0) window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    document.documentElement.classList.toggle("floor-busy", busy);
  }

  /** node: the roll, which carries its position and state. box: its film layer, used for measuring. dx/dy: offset in px from where the stylesheet puts the strip. rot: its angle in degrees. vx/vy/vr: speed per ms while it slides. */
  type Roll = { node: HTMLElement; box: HTMLElement; pick: HTMLButtonElement; shots: HTMLAnchorElement[]; name: string; dx: number; dy: number; rot: number; vx: number; vy: number; vr: number };
  const rolls: Roll[] = [...floor.querySelectorAll<HTMLElement>(".roll")].map((node) => ({
    node,
    box: node.querySelector<HTMLElement>(".strip.base")!,
    pick: node.querySelector<HTMLButtonElement>(".pick")!,
    shots: [...node.querySelectorAll<HTMLAnchorElement>(".shot")],
    name: node.querySelector(".lname")?.textContent ?? "",
    dx: 0, dy: 0, rot: 0, vx: 0, vy: 0, vr: 0,
  }));
  const byKey = new Map(rolls.map((r) => [r.node.dataset.key!, r]));
  const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
  const shuffle = <T,>(list: T[]) => list.map((v) => [Math.random(), v] as const).sort((a, b) => a[0] - b[0]).map(([, v]) => v);

  // ---------- Which rolls are on the floor ----------
  // Only the featured ones (a random few of them if there are more than fit); with nothing featured, a random few of
  // them all. The others are hidden until the globe, the next-roll button or the viewer asks for them.
  // A phone gets three rolls, smaller ones (see .floor), standing up side by side: four were too much film for its width.
  const phone = floor.clientWidth < 700;
  const FLOOR_MAX = phone ? 3 : 6;
  const featured = rolls.filter((r) => "featured" in r.node.dataset);
  const onFloor = shuffle(featured.length ? featured : rolls).slice(0, FLOOR_MAX);
  /** Give a roll its photos (they are left unloaded in the page until the roll is on the floor). */
  function load(r: Roll) {
    for (const img of r.node.querySelectorAll<HTMLImageElement>("img[data-src]")) {
      img.srcset = img.dataset.srcset ?? "";
      img.src = img.dataset.src!;
      delete img.dataset.src;
      delete img.dataset.srcset;
    }
  }
  for (const r of rolls) {
    if (onFloor.includes(r)) load(r);
    else { r.node.classList.add("away"); r.pick.tabIndex = -1; }
  }

  let held: Roll | null = null;
  let pan = 0;
  let panMax = 0;
  let scale = 1;
  /** How much the held roll is enlarged. It opens by being scaled up, and once open it is laid out at that size instead
      (big), with no scale left on it: Safari draws a scaled-up layer at its small size and stretches it, which left
      the photos of an open roll soft on an iPhone however large the files behind them. */
  let openScale = 1;
  let big = false;
  /** Ask for the larger files for a roll's photos, now that they are shown large. */
  const sharpen = (r: Roll) => { for (const a of r.shots) a.querySelector("img")!.sizes = "(max-width: 700px) 90vw, 1100px"; };
  let top = rolls.length;
  let topRoll: Roll | null = null;
  const raise = (r: Roll) => { if (r !== topRoll) { topRoll = r; r.node.style.setProperty("--z", String(++top)); } };
  const place = (r: Roll, x: number, y: number) => { r.node.style.setProperty("--dx", `${x}px`); r.node.style.setProperty("--dy", `${y}px`); };
  const turn = (r: Roll) => r.node.style.setProperty("--a", `${r.rot.toFixed(2)}deg`);
  /** Where the strip's middle is on the floor, in px. */
  const centre = (r: Roll) => ({ x: r.box.offsetLeft + r.dx, y: r.box.offsetTop + r.dy });
  /** Move a strip's middle to a point, kept on the floor so no roll can be lost off the edge. Returns false if it hit an edge. */
  function moveTo(r: Roll, x: number, y: number) {
    const cx = clamp(x, 0, floor.clientWidth), cy = clamp(y, 0, floor.clientHeight);
    r.dx = cx - r.box.offsetLeft; r.dy = cy - r.box.offsetTop;
    place(r, r.dx, r.dy);
    return cx === x && cy === y;
  }

  // ---------- A fresh spill on every visit ----------
  // Angles are dealt from evenly spaced slots so no two rolls land parallel; on tall screens they lean towards vertical.
  // Every roll lands clear of the small globe in the corner: positions are drawn at random until one misses it, first
  // near the middle and then further out and at a slightly different angle; failing that, the clearest one tried wins.
  // No more than two rolls ever lie on top of one another: a place is turned down if the roll would cover a spot where
  // two others already cross.
  type Pt = [number, number];
  /** The four corners of a strip of this size, centred here and turned this far. */
  const corners = (x: number, y: number, deg: number, w: number, h: number): Pt[] => {
    const c = Math.cos((deg * Math.PI) / 180), s = Math.sin((deg * Math.PI) / 180), u: Pt = [(c * w) / 2, (s * w) / 2], v: Pt = [(-s * h) / 2, (c * h) / 2];
    return [[x - u[0] - v[0], y - u[1] - v[1]], [x + u[0] - v[0], y + u[1] - v[1]], [x + u[0] + v[0], y + u[1] + v[1]], [x - u[0] + v[0], y - u[1] + v[1]]];
  };
  /** The part of one convex shape that lies inside another (both listed clockwise on screen). */
  function clip(shape: Pt[], by: Pt[]): Pt[] {
    let out = shape;
    for (let i = 0; i < by.length && out.length; i++) {
      const [ax, ay] = by[i], [bx, by2] = by[(i + 1) % by.length];
      const side = ([px, py]: Pt) => (bx - ax) * (py - ay) - (by2 - ay) * (px - ax);
      const inp = out; out = [];
      for (let j = 0; j < inp.length; j++) {
        const p = inp[j], q = inp[(j + 1) % inp.length], sp = side(p), sq = side(q);
        if (sp >= 0) out.push(p);
        if ((sp >= 0) !== (sq >= 0)) { const t = sp / (sp - sq); out.push([p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])]); }
      }
    }
    return out;
  }
  const area = (poly: Pt[]) => Math.abs(poly.reduce((a, p, i) => { const q = poly[(i + 1) % poly.length]; return a + p[0] * q[1] - q[0] * p[1]; }, 0)) / 2;
  /** The rolls already laid on the floor. */
  const laid = new Set<Roll>();
  const outline = (r: Roll) => { const m = centre(r); return corners(m.x, m.y, r.rot, r.box.offsetWidth, r.box.offsetHeight); };
  /** Lay a roll on the floor at roughly this angle (degrees, measured for a wide screen), somewhere clear of the globe. */
  function land(r: Roll, wide: number, across?: number) {
    const W = floor.clientWidth, H = floor.clientHeight;
    const angle = W < H ? Math.sign(wide || 1) * (90 - Math.abs(wide)) : wide;
    // The small globe sits in the lower right corner; leave room round it for its ripples too.
    const gBtn = el("globeOpen"), gR = gBtn.offsetWidth / 2 + 36; // with "See more" above it
    const gX = gBtn.offsetLeft + gBtn.offsetWidth / 2, gY = gBtn.offsetTop + gBtn.offsetHeight / 2;
    /** How far the globe's edge is from the strip, in px (negative when they overlap). */
    const clearance = (x: number, y: number, deg: number) => {
      const c = Math.cos((deg * Math.PI) / 180), s = Math.sin((deg * Math.PI) / 180), gx = gX - x, gy = gY - y;
      const u = Math.abs(gx * c + gy * s) - r.box.offsetWidth / 2, v = Math.abs(-gx * s + gy * c) - r.box.offsetHeight / 2;
      return Math.hypot(Math.max(u, 0), Math.max(v, 0)) - gR;
    };
    // Every pair of rolls already down that cross each other, as the shape where they cross.
    const others = [...laid].filter((o) => o !== r && !o.node.classList.contains("away")).map(outline);
    const crossings: Pt[][] = [];
    for (let i = 0; i < others.length; i++) for (let j = i + 1; j < others.length; j++) {
      const both = clip(others[i], others[j]);
      if (both.length > 2 && area(both) > 1) crossings.push(both);
    }
    /** How much of the floor this place would make three rolls deep, in px². */
    const third = (x: number, y: number, deg: number) => {
      const me = corners(x, y, deg, r.box.offsetWidth, r.box.offsetHeight);
      return crossings.reduce((sum, cr) => { const p = clip(me, cr); return sum + (p.length > 2 ? area(p) : 0); }, 0);
    };
    // A third layer rules a place out ahead of anything else; among the places with none, the one clearest of the globe
    // wins. Only if every place tried makes one does the least of it win.
    let best = { c: -Infinity, x: W / 2, y: H / 2, a: angle };
    for (let t = 0; t < 400 && best.c < 0; t++) {
      const far = t >= 40, a = t >= 80 ? angle + rand(-30, 30) : angle;
      // Given a place across the floor (0 to 1), the first tries keep to it.
      const x = W * (far ? rand(0.1, 0.9) : across !== undefined ? across + rand(-0.05, 0.05) : rand(0.25, 0.75)), y = H * (far ? rand(0.2, 0.8) : rand(0.3, 0.7));
      const deep = third(x, y, a), c = deep > 1 ? -1e6 - deep : clearance(x, y, a);
      if (c > best.c) best = { c, x, y, a };
    }
    laid.add(r);
    r.rot = best.a;
    turn(r);
    r.node.style.setProperty("--spin", `${rand(8, 18) * (Math.random() < 0.5 ? -1 : 1)}deg`);
    moveTo(r, best.x, best.y);
  }
  {
    const slots = shuffle(onFloor.map((_, i) => i));
    onFloor.forEach((r, i) => {
      r.node.classList.add("loose");
      // On a phone they stand side by side, leaning only a little (within 25° of upright), so they touch at most near
      // their ends instead of all crossing in the middle.
      if (phone) land(r, -25 + ((slots[i] + rand(0.25, 0.75)) * 50) / onFloor.length, (i + 0.5) / onFloor.length);
      else land(r, -65 + ((slots[i] + rand(0.15, 0.85)) * 130) / onFloor.length);
    });
    requestAnimationFrame(() => requestAnimationFrame(() => onFloor.forEach((r) => r.node.classList.remove("loose"))));
  }
  /** Bring a roll that isn't on the floor onto it: falling in like the others did, or quietly when it is about to be
      picked up or gathered anyway. Returns true if it had to come in. */
  function arrive(r: Roll, fall: boolean) {
    if (!r.node.classList.contains("away")) return false;
    r.node.classList.remove("away");
    r.node.classList.toggle("quiet", !fall);
    r.node.style.setProperty("--delay", "0s");
    load(r);
    r.pick.tabIndex = 0;
    r.node.classList.add("loose");
    land(r, rand(-65, 65));
    requestAnimationFrame(() => requestAnimationFrame(() => r.node.classList.remove("loose")));
    return true;
  }
  /** The rolls on the floor. A collection that isn't featured joins them only once it has been opened from the globe, so
      Next, the arrow keys and the viewer never lead to one that hasn't. */
  const onFloorNow = () => rolls.filter((r) => !r.node.classList.contains("away"));
  /** The roll after (or before) this one, through the rolls on the floor in A to Z order and round again. */
  function nextRoll(r: Roll, step = 1) {
    const list = onFloorNow();
    return list[(list.indexOf(r) + step + list.length) % list.length];
  }

  // ---------- Pick up / put back ----------
  /** Space a held roll leaves above it (header and Put back) and below it, in px. */
  const TOP_ROOM = 125, BOTTOM_ROOM = 32;
  /** Where the middle of a held roll sits, in px down the floor: centred in that room. */
  let heldY = 0;
  /** Where the middle of each photo of the held roll is, in px from the middle of the roll at its own size. Measured
      once when it is picked up (and on resize), so winding never has to measure the page while it moves: that made
      Safari lay the page out again in the middle of every frame. */
  let centres: number[] = [];
  /** Put the held roll's middle at the centre of the floor wound by p, and at heldY. It is moved only by its transform:
      its left and top stay where they were on the floor, because Safari lays the page out again for every frame that
      they move and rounds them to whole pixels, while the transform moves smoothly between them, so the two together
      wobbled. */
  const atHeld = (r: Roll, p: number) => place(r, floor.clientWidth / 2 - r.box.offsetLeft + p, heldY - r.box.offsetTop);
  /** The middle of a roll's first photo on screen (or of the roll, if it has none). */
  const firstPhoto = (r: Roll) => {
    const b = (r.shots[0] ?? r.box).getBoundingClientRect();
    return { x: b.left + b.width / 2, y: b.top + b.height / 2 };
  };
  /** Change a roll's layout between the floor and held (blank frames, the name on the leader) without the photos
      jumping: the change is made with no animation, the roll is shifted so its first photo is where it was, and only
      then does it move on to where it is going. Without this a roll lost its blank frames and grew its leader on the
      first frame and visibly snapped shorter before it moved. */
  function relayout(r: Roll, change: () => void, from: { dx: number; dy: number }) {
    const was = firstPhoto(r);
    r.node.classList.add("loose", "steady");
    change();
    place(r, from.dx, from.dy);
    const now = firstPhoto(r);
    place(r, from.dx + was.x - now.x, from.dy + was.y - now.y);
    void r.box.offsetWidth; // the roll starts from here
    r.node.classList.remove("loose", "steady");
  }
  /** Size the held strip as large as the screen allows and work out how far it can be wound either way. */
  function fit(r: Roll, keepPan = false) {
    // Up to 855 px tall (half as big again as it used to be), but it stays clear of the header and Put back above and the
    // bottom of the screen, and the name on the leader always fits across the screen, which is what limits it on phones.
    // Measured at its floor size: an open roll laid out big goes back to that for a moment, unseen, and is made big again below.
    const wasBig = big;
    if (wasBig) { r.node.classList.add("loose"); r.node.style.removeProperty("--h"); big = false; }
    const W = floor.clientWidth, H = floor.clientHeight;
    const lead = r.box.querySelector<HTMLElement>(".leader")!.offsetWidth;
    // The leader starts 0.12 of the film's height in from the strip's end, which opens 24 px from the left edge.
    const h = r.box.offsetHeight;
