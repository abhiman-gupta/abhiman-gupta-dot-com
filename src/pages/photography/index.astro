  .held-count { display: flex; gap: 12px; margin: 0; padding: 8px 0; color: var(--muted); font-variant-numeric: tabular-nums; }
  .held-title { color: var(--ink); }
  .held-actions { display: flex; align-items: baseline; gap: clamp(14px, 2vw, 24px); }
  /* While a roll is open: a dark pill offering the next one, its arrow nudging the way. */
  .next-roll {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 999px; white-space: nowrap;
    background: var(--ink); color: var(--paper); font: 500 0.78rem/1.2 var(--display); letter-spacing: -0.01em;
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.45); animation: next-in 0.35s var(--ease);
