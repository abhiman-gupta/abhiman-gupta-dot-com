---
/**
 * Photography index: a turning globe with a red marker for each location in photography/locations/.
 * The globe is a WebGL sphere textured with Natural Earth II (public domain, public/textures/earth.jpg);
 * borders and markers are an SVG layer drawn with the same d3 orthographic projection on top.
 * Picking a place opens a drawer with its photos; side banners point to places on the far side of the globe.
 */
import { getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { getLocations, placeLine } from "../../lib/photos";

/** The location the globe starts on and the Home button returns to. */
const HOME = "tucson";

const locations = await Promise.all(
  getLocations().map(async (l) => ({
    ...l,
    line: placeLine(l),
    thumbs: await Promise.all(
      l.photos.map(async (p) => {
        const img = await getImage({ src: p.image, widths: [400, 800], format: "webp", quality: 80 });
        const full = await getImage({ src: p.image, widths: [1000, 1600, 2400], format: "webp", quality: 85 });
        return { src: img.src, srcset: img.srcSet.attribute, full: full.src, fullSrcset: full.srcSet.attribute, portrait: p.orientation === "portrait" };
      })
    ),
  }))
);
const markers = JSON.stringify(locations.map((l) => ({ key: l.slug, name: l.name, n: l.photos.length, lat: l.lat, lon: l.lon })));
const photoCount = (n: number) => (n === 0 ? "No photos yet" : `${n} ${n === 1 ? "photo" : "photos"}`);
---
<Base title="Photography · Abhiman Gupta" description="Photography by Abhiman Gupta, by place." current="photography">
  <section class="atlas" id="atlas">
    <header class="page-head wrap globe-head">
      <h1 class="page-title">Photo<em>graphy</em></h1>
    </header>

    <div class="globe-stage" id="stage">
      <div class="globe-box" id="box">
        <canvas id="earth" class="earth" aria-hidden="true"></canvas>
        <svg id="globe" class="globe" viewBox="0 0 800 800" role="img" aria-label="Globe. Drag to turn it; red markers show where the photographs were taken." data-markers={markers} data-home={HOME}>
          <defs><clipPath id="lens"><circle cx="400" cy="400" r="361" /></clipPath></defs>
          <g clip-path="url(#lens)">
            <path class="fallback-sphere" id="fallbackSphere" />
            <path class="fallback-land" id="fallbackLand" />
            <path class="graticule" id="graticule" />
            <path class="borders" id="borders" />
            <path class="state-borders" id="stateBorders" />
            <g id="pins"></g>
          </g>
        </svg>
        <div class="controls">
          <button id="home" class="home-btn" aria-label="Back to Tucson" title="Back to Tucson"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M3.5 11 12 4l8.5 7M6 9.2V20h4.5v-5.5h3V20H18V9.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button id="zoomIn" aria-label="Zoom in">+</button>
          <button id="zoomOut" aria-label="Zoom out">−</button>
        </div>
      </div>
      <button class="nudge left" id="nudgeL" data-side="left" tabindex="-1" aria-hidden="true"><span class="arrow" aria-hidden="true">←</span><span class="ntext"></span></button>
      <button class="nudge right" id="nudgeR" data-side="right" tabindex="-1" aria-hidden="true"><span class="ntext"></span><span class="arrow" aria-hidden="true">→</span></button>
      <div class="tip" id="tip" hidden></div>
    </div>
    <p class="label hint">Drag to turn</p>
  </section>

  <section class="places wrap" aria-label="Places">
    <p class="label">Places</p>
    <ul class="place-list">
      {locations.map((l) => (
        <li>
          <button class="place-btn" data-key={l.slug}>
            <span class="pname">{l.name}</span>
            <span class="label">{l.line} · {photoCount(l.photos.length)}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>

  <aside class="drawer" id="drawer" aria-label="Photos from this place" inert>
    <button class="close label" id="drawerClose">Close ✕</button>
    {locations.map((l) => (
      <div class="place-detail" data-place={l.slug} hidden>
        <h2 class="place-title" tabindex="-1">{l.name}</h2>
        <p class="label">{l.line}</p>
        {l.thumbs.length > 0 ? (
          <div class="thumbs">
            {l.thumbs.map((t, i) => (
              <a href={t.full} class={t.portrait ? "thumb portrait" : "thumb"} data-full={t.full} data-full-srcset={t.fullSrcset} data-i={i}>
                <img src={t.src} srcset={t.srcset} sizes="(max-width: 700px) 45vw, 190px" alt={`${l.name}, photo ${i + 1}`} loading="lazy" />
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">{photoCount(0)}</p>
        )}
      </div>
    ))}
  </aside>

  <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
    <div class="viewer-bar">
      <p class="viewer-title"><span id="viewerPlace"></span> <span class="viewer-count" id="viewerCount"></span></p>
      <button class="viewer-close" id="viewerClose" aria-label="Close photo">Close ✕</button>
    </div>
    <div class="viewer-stage" id="viewerStage">
      <img id="viewerImg" alt="" sizes="100vw" draggable="false" />
    </div>
    <button class="viewer-nav prev" id="viewerPrev" aria-label="Previous photo">←</button>
    <button class="viewer-nav next" id="viewerNext" aria-label="Next photo">→</button>
  </div>
</Base>

<script>
  import { geoOrthographic, geoPath, geoGraticule10, geoDistance } from "d3-geo";
  import { feature, mesh } from "topojson-client";
  import type { Topology, GeometryCollection } from "topojson-specification";
  import world from "world-atlas/countries-110m.json";
  import us from "us-atlas/states-10m.json";

  type Marker = { key: string; name: string; n: number; lat: number; lon: number };
  const NS = "http://www.w3.org/2000/svg";
  const VB = 800;
  const R = 360;
  const LENS = R + 1;
  const svg = document.getElementById("globe") as unknown as SVGSVGElement;
  const canvas = document.getElementById("earth") as HTMLCanvasElement;
  const stage = document.getElementById("stage")!;
  const atlas = document.getElementById("atlas")!;
  const tip = document.getElementById("tip")!;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const markers: Marker[] = JSON.parse(svg.dataset.markers ?? "[]");
  const byKey = new Map(markers.map((m) => [m.key, m]));
  const home = byKey.get(svg.dataset.home ?? "") ?? markers[0];

  const wt = world as unknown as Topology<{ countries: GeometryCollection; land: GeometryCollection }>;
  const ut = us as unknown as Topology<{ states: GeometryCollection }>;
  const borders = mesh(wt, wt.objects.countries, (a, b) => a !== b);
  const stateBorders = mesh(ut, ut.objects.states, (a, b) => a !== b);
  const land = feature(wt, wt.objects.land);

  const projection = geoOrthographic().translate([VB / 2, VB / 2]).scale(R).clipAngle(90).precision(0.4);
  const path = geoPath(projection);
  const graticule = geoGraticule10();
  const el = (id: string) => document.getElementById(id)!;
  const wrap180 = (d: number) => ((((d + 180) % 360) + 360) % 360) - 180;

  const pins = markers.map((m) => {
    const g = document.createElementNS(NS, "g");
    g.setAttribute("class", m.n ? "pin" : "pin empty");
    g.dataset.key = m.key;
    g.innerHTML = `<circle class="pulse" r="10"/><circle class="dot" r="5.5"/>`;
    el("pins").appendChild(g);
    return { g, m, at: [m.lon, m.lat] as [number, number], visible: false };
  });

  // ---------- WebGL terrain ----------
  const gl = canvas.getContext("webgl2", { premultipliedAlpha: true, antialias: false });
  let glReady = false;
  let uSize: WebGLUniformLocation | null, uRadius: WebGLUniformLocation | null, uCenter: WebGLUniformLocation | null;

  function initGL(g: WebGL2RenderingContext) {
    const vs = `#version 300 es
      in vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
    const fs = `#version 300 es
      precision highp float;
      uniform sampler2D tex; uniform vec2 size; uniform float radius; uniform vec2 center;
      out vec4 o;
      const float PI = 3.14159265;
      void main() {
        float px = ${VB.toFixed(1)} / size.x;                  // one device pixel in viewBox units
        vec2 d = vec2(gl_FragCoord.x, size.y - gl_FragCoord.y) * px - ${(VB / 2).toFixed(1)};
        float lens = clamp((${(LENS - 0.5).toFixed(1)} - length(d)) / px, 0.0, 1.0);
        vec2 q = vec2(d.x, -d.y) / radius;
        float r = length(q);
        float a = clamp((1.0 - r) * radius / px, 0.0, 1.0) * lens;
        if (a <= 0.0) discard;
        float z = sqrt(max(0.0, 1.0 - r * r));
        float lat = asin(clamp(z * sin(center.y) + q.y * cos(center.y), -1.0, 1.0));
        float lon = center.x + atan(q.x, z * cos(center.y) - q.y * sin(center.y));
        float u = lon / (2.0 * PI) + 0.5;
        float v = 0.5 - lat / PI;
        // Pick whichever wrap of u is continuous here, so mipmapping leaves no seam at the date line.
        float u1 = fract(u), u2 = fract(u + 0.5) - 0.5;
        float uu = fwidth(u1) <= fwidth(u2) + 1e-6 ? u1 : u2;
        vec3 c = texture(tex, vec2(uu, v)).rgb;
        vec3 n = vec3(q, z);
        float light = clamp(dot(n, normalize(vec3(-0.45, 0.5, 0.8))), 0.0, 1.0);
        c *= 0.74 + 0.36 * light;
        c = mix(c, vec3(0.82, 0.9, 1.0), pow(1.0 - z, 3.0) * 0.45);
        o = vec4(c * a, a);
      }`;
    const sh = (type: number, src: string) => {
      const s = g.createShader(type)!;
      g.shaderSource(s, src);
      g.compileShader(s);
      if (!g.getShaderParameter(s, g.COMPILE_STATUS)) throw new Error(g.getShaderInfoLog(s) ?? "shader");
      return s;
    };
    const prog = g.createProgram()!;
    g.attachShader(prog, sh(g.VERTEX_SHADER, vs));
    g.attachShader(prog, sh(g.FRAGMENT_SHADER, fs));
    g.linkProgram(prog);
    if (!g.getProgramParameter(prog, g.LINK_STATUS)) throw new Error(g.getProgramInfoLog(prog) ?? "link");
    g.useProgram(prog);
    const buf = g.createBuffer();
    g.bindBuffer(g.ARRAY_BUFFER, buf);
    g.bufferData(g.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), g.STATIC_DRAW);
    const loc = g.getAttribLocation(prog, "p");
    g.enableVertexAttribArray(loc);
    g.vertexAttribPointer(loc, 2, g.FLOAT, false, 0, 0);
    uSize = g.getUniformLocation(prog, "size");
    uRadius = g.getUniformLocation(prog, "radius");
    uCenter = g.getUniformLocation(prog, "center");

    const img = new Image();
    img.decoding = "async";
    img.onload = () => {
      const t = g.createTexture();
      g.bindTexture(g.TEXTURE_2D, t);
      g.texImage2D(g.TEXTURE_2D, 0, g.RGB, g.RGB, g.UNSIGNED_BYTE, img);
      g.generateMipmap(g.TEXTURE_2D);
      g.texParameteri(g.TEXTURE_2D, g.TEXTURE_MIN_FILTER, g.LINEAR_MIPMAP_LINEAR);
      g.texParameteri(g.TEXTURE_2D, g.TEXTURE_MAG_FILTER, g.LINEAR);
      g.texParameteri(g.TEXTURE_2D, g.TEXTURE_WRAP_S, g.REPEAT);
      g.texParameteri(g.TEXTURE_2D, g.TEXTURE_WRAP_T, g.CLAMP_TO_EDGE);
      const aniso = g.getExtension("EXT_texture_filter_anisotropic");
      if (aniso) g.texParameterf(g.TEXTURE_2D, aniso.TEXTURE_MAX_ANISOTROPY_EXT, Math.min(8, g.getParameter(aniso.MAX_TEXTURE_MAX_ANISOTROPY_EXT)));
      glReady = true;
      svg.classList.add("gl");
      dirty = true;
    };
    img.src = "/textures/earth.jpg";
  }
  if (gl) {
    try { initGL(gl); } catch (err) { console.warn("Globe: WebGL unavailable, using flat map.", err); }
  }

  function sizeCanvas() {
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    const w = Math.round(canvas.clientWidth * dpr);
    if (w > 0 && canvas.width !== w) { canvas.width = w; canvas.height = w; dirty = true; }
  }
  new ResizeObserver(sizeCanvas).observe(canvas);

  // ---------- State & render ----------
  let rot: [number, number] = home ? [-home.lon, -home.lat] : [100, -28];
  let zoom = 1;
  let vel = 0;
  let dirty = true;
  let selected: string | null = null;
  let hovered: string | null = null;
  let lastInteract = 0;
  let dragging = false;
  let fly: { from: [number, number, number]; to: [number, number, number]; t0: number; dur: number } | null = null;

  function render() {
    projection.rotate([rot[0], rot[1]]).scale(R * zoom);
    if (gl && glReady) {
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uSize, canvas.width, canvas.height);
      gl.uniform1f(uRadius, R * zoom);
      gl.uniform2f(uCenter, (-rot[0] * Math.PI) / 180, (-rot[1] * Math.PI) / 180);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    } else {
      el("fallbackSphere").setAttribute("d", path({ type: "Sphere" }) ?? "");
      el("fallbackLand").setAttribute("d", path(land) ?? "");
    }
    el("graticule").setAttribute("d", path(graticule) ?? "");
    el("borders").setAttribute("d", path(borders) ?? "");
    el("stateBorders").setAttribute("d", path(stateBorders) ?? "");
    const center: [number, number] = [-rot[0], -rot[1]];
    for (const p of pins) {
      const xy = projection(p.at);
      p.visible = !!xy && geoDistance(p.at, center) < Math.PI / 2 - 0.03 && Math.hypot(xy[0] - VB / 2, xy[1] - VB / 2) < LENS - 4;
      p.g.classList.toggle("hidden", !p.visible);
      if (xy) p.g.setAttribute("transform", `translate(${xy[0].toFixed(1)} ${xy[1].toFixed(1)})`);
    }
    updateNudges();
    dirty = false;
  }

  // ---------- Side banners: how many places are out of view on each side ----------
  const WORDS = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine"];
  const nudges = {
    left: { btn: el("nudgeL") as HTMLButtonElement, text: el("nudgeL").querySelector(".ntext")!, key: "", targets: [] as Marker[] },
    right: { btn: el("nudgeR") as HTMLButtonElement, text: el("nudgeR").querySelector(".ntext")!, key: "", targets: [] as Marker[] },
  };
  function updateNudges() {
    const left: { m: Marker; d: number }[] = [], right: { m: Marker; d: number }[] = [];
    for (const p of pins) {
      if (p.visible) continue;
      const d = wrap180(p.m.lon + rot[0]); // + means east of the view centre, i.e. round to the right
      (d >= 0 ? right : left).push({ m: p.m, d: Math.abs(d) });
    }
    for (const [side, list] of [["left", left], ["right", right]] as const) {
      const n = nudges[side];
      const sorted = list.sort((a, b) => a.d - b.d).map((x) => x.m);
      const key = sorted.map((m) => m.key).join(",");
      n.targets = sorted;
      if (key === n.key) continue;
      n.key = key;
      const count = sorted.length;
      n.btn.classList.toggle("show", count > 0);
      n.btn.tabIndex = count > 0 ? 0 : -1;
      n.btn.setAttribute("aria-hidden", count > 0 ? "false" : "true");
      if (count > 0) {
        const word = WORDS[count] ?? String(count);
        n.text.textContent = `${word} more`;
        n.btn.setAttribute("aria-label", `Turn the globe ${side}: ${count} more ${count === 1 ? "place" : "places"} with photos that way`);
      }
    }
  }
  for (const side of ["left", "right"] as const) {
    nudges[side].btn.addEventListener("click", () => {
      const m = nudges[side].targets[0];
      if (m) flyTo(m, Math.min(zoom, 1.4));
    });
  }

  function setClasses() {
    for (const p of pins) {
      p.g.classList.toggle("hot", p.m.key === hovered);
      p.g.classList.toggle("sel", p.m.key === selected);
    }
  }

  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  function tick(now: number) {
    if (fly) {
      const t = Math.min(1, (now - fly.t0) / fly.dur);
      const e = ease(t);
      rot = [fly.from[0] + (fly.to[0] - fly.from[0]) * e, fly.from[1] + (fly.to[1] - fly.from[1]) * e];
      zoom = fly.from[2] + (fly.to[2] - fly.from[2]) * e;
      dirty = true;
      if (t === 1) { fly = null; lastInteract = now; }
    } else if (!dragging) {
      if (Math.abs(vel) > 0.01) { rot[0] += vel; vel *= 0.94; dirty = true; }
      else if (!reduced && !selected && now - lastInteract > 4000) { rot[0] += 0.08; dirty = true; }
    }
    if (dirty) render();
    requestAnimationFrame(tick);
  }

  function flyTo(m: Marker, z: number) {
    const target = rot[0] + wrap180(-m.lon - rot[0]);
    fly = { from: [rot[0], rot[1], zoom], to: [target, -m.lat, z], t0: performance.now(), dur: reduced ? 1 : 1200 };
    lastInteract = performance.now();
  }

  // ---------- Drawer ----------
  const drawer = el("drawer");
  const details = document.querySelectorAll<HTMLElement>(".place-detail");
  function select(key: string | null) {
    selected = key;
    const m = key ? byKey.get(key) : undefined;
    details.forEach((d) => (d.hidden = d.dataset.place !== key));
    drawer.classList.toggle("open", !!m);
    atlas.classList.toggle("drawer-open", !!m);
    if (m) { drawer.removeAttribute("inert"); drawer.querySelector<HTMLElement>(`[data-place="${m.key}"] .place-title`)?.focus({ preventScroll: true }); flyTo(m, 2.4); }
    else { drawer.setAttribute("inert", ""); fly = { from: [rot[0], rot[1], zoom], to: [rot[0], rot[1], 1], t0: performance.now(), dur: reduced ? 1 : 700 }; }
    setClasses();
    lastInteract = performance.now();
  }
  document.querySelectorAll<HTMLButtonElement>(".place-btn").forEach((b) => b.addEventListener("click", () => {
    select(b.dataset.key!);
    window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
  }));
  el("drawerClose").addEventListener("click", () => select(null));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && selected && viewer.hidden) select(null); });

  // ---------- Photo viewer ----------
  const viewer = el("viewer");
  const viewerImg = el("viewerImg") as HTMLImageElement;
  let shots: HTMLAnchorElement[] = [];
  let shot = 0;
  let opener: HTMLElement | null = null;
  function showShot(i: number) {
    shot = (i + shots.length) % shots.length;
    const a = shots[shot];
    viewerImg.classList.add("swap");
    const img = a.querySelector("img")!;
    viewerImg.srcset = a.dataset.fullSrcset ?? "";
    viewerImg.src = a.dataset.full ?? a.href;
    viewerImg.alt = img.alt;
    el("viewerCount").textContent = shots.length > 1 ? `${shot + 1} / ${shots.length}` : "";
    const many = shots.length > 1;
    el("viewerPrev").hidden = !many;
    el("viewerNext").hidden = !many;
  }
  viewerImg.addEventListener("load", () => viewerImg.classList.remove("swap"));
  function openViewer(a: HTMLAnchorElement) {
    const detail = a.closest<HTMLElement>(".place-detail")!;
    shots = [...detail.querySelectorAll<HTMLAnchorElement>(".thumb")];
    el("viewerPlace").textContent = detail.querySelector(".place-title")?.textContent ?? "";
    opener = a;
    viewer.hidden = false;
    document.documentElement.classList.add("viewer-open");
    showShot(Number(a.dataset.i));
    el("viewerClose").focus();
  }
  function closeViewer() {
    viewer.hidden = true;
    document.documentElement.classList.remove("viewer-open");
    viewerImg.removeAttribute("src");
    viewerImg.removeAttribute("srcset");
    opener?.focus();
  }
  document.querySelectorAll<HTMLAnchorElement>(".thumb").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); openViewer(a); }));
  el("viewerClose").addEventListener("click", closeViewer);
  el("viewerPrev").addEventListener("click", () => showShot(shot - 1));
  el("viewerNext").addEventListener("click", () => showShot(shot + 1));
  document.addEventListener("keydown", (e) => {
    if (viewer.hidden) return;
    if (e.key === "Escape") closeViewer();
    else if (e.key === "ArrowRight" && shots.length > 1) showShot(shot + 1);
    else if (e.key === "ArrowLeft" && shots.length > 1) showShot(shot - 1);
    else return;
    e.preventDefault();
  });
  // Swipe left/right on touch; a tap on the dark area around the photo closes it.
  let swipe: { x: number; y: number } | null = null;
  const vStage = el("viewerStage");
  vStage.addEventListener("pointerdown", (e) => { swipe = { x: e.clientX, y: e.clientY }; });
  vStage.addEventListener("pointerup", (e) => {
    if (!swipe) return;
    const dx = e.clientX - swipe.x, dy = e.clientY - swipe.y;
    swipe = null;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) && shots.length > 1) showShot(shot + (dx < 0 ? 1 : -1));
    else if (Math.abs(dx) < 6 && Math.abs(dy) < 6 && e.target === vStage) closeViewer();
  });

  // ---------- Controls ----------
  const setZoom = (z: number) => { zoom = Math.max(0.8, Math.min(6, z)); fly = null; dirty = true; lastInteract = performance.now(); };
  el("zoomIn").addEventListener("click", () => setZoom(zoom * 1.4));
  el("zoomOut").addEventListener("click", () => setZoom(zoom / 1.4));
  el("home").addEventListener("click", () => { if (home) flyTo(home, 1); });
  svg.addEventListener("wheel", (e) => { e.preventDefault(); setZoom(zoom * Math.exp(-e.deltaY * 0.0015)); }, { passive: false });

  // ---------- Drag / hover / click ----------
  let moved = 0;
  let last = { x: 0, y: 0, t: 0 };
  const toVB = (e: PointerEvent) => {
    const r = svg.getBoundingClientRect();
    return { x: ((e.clientX - r.left) / r.width) * VB, y: ((e.clientY - r.top) / r.height) * VB, scale: VB / r.width };
  };
  svg.addEventListener("pointerdown", (e) => {
    dragging = true; fly = null; vel = 0; moved = 0;
    last = { x: e.clientX, y: e.clientY, t: performance.now() };
    svg.setPointerCapture(e.pointerId);
    svg.classList.add("grabbing");
  });
  svg.addEventListener("pointermove", (e) => {
    if (dragging) {
      const dx = e.clientX - last.x, dy = e.clientY - last.y;
      moved += Math.abs(dx) + Math.abs(dy);
      const k = toVB(e).scale * (0.25 / zoom);
      rot = [rot[0] + dx * k, Math.max(-80, Math.min(80, rot[1] - dy * k))];
      vel = dx * k;
      last = { x: e.clientX, y: e.clientY, t: performance.now() };
      dirty = true;
      tip.hidden = true;
      return;
    }
    hover(e);
  });
  const end = (e: PointerEvent) => {
    if (!dragging) return;
    dragging = false;
    svg.classList.remove("grabbing");
    lastInteract = performance.now();
    if (performance.now() - last.t > 80) vel = 0;
    if (moved < 5) {
      vel = 0;
      const key = markerAt(e);
      if (key) select(key);
    }
  };
  svg.addEventListener("pointerup", end);
  svg.addEventListener("pointercancel", end);
  svg.addEventListener("pointerleave", () => { if (!dragging) { hovered = null; tip.hidden = true; svg.classList.remove("pointing"); setClasses(); } });

  /** Nearest visible marker within ~20 screen px. */
  function markerAt(e: PointerEvent): string | null {
    const { x, y, scale } = toVB(e);
    let best: string | null = null, bestD = 20 * scale;
    for (const p of pins) {
      if (!p.visible) continue;
      const xy = projection(p.at);
      if (!xy) continue;
      const d = Math.hypot(xy[0] - x, xy[1] - y);
      if (d < bestD) { bestD = d; best = p.m.key; }
    }
    return best;
  }

  function hover(e: PointerEvent) {
    const key = markerAt(e);
    if (key !== hovered) { hovered = key; setClasses(); }
    svg.classList.toggle("pointing", !!key);
    if (key) {
      tip.textContent = byKey.get(key)!.name;
      const r = stage.getBoundingClientRect();
      tip.style.transform = `translate(${e.clientX - r.left + 14}px, ${e.clientY - r.top + 14}px)`;
      tip.hidden = false;
    } else tip.hidden = true;
  }

  sizeCanvas();
  render();
  requestAnimationFrame(tick);
</script>

<style>
